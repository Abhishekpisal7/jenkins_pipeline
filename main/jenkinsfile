pipeline {
    agent {
        docker {
            image "docker.io/aquasec/trivy"
        }
    }

    stages{
        stage("checkout"){
            steps{
                checkout scm
            }
        }
        stage("Trivey FS Scan"){
            steps{
                 sh '''
                    docker run --rm \
                      -v "$PWD:/scan" \
                      aquasec/trivy \
                      fs --exit-code 1 \
                      --severity HIGH,CRITICAL \
                      /scan
                '''
            }
        }
    }
}