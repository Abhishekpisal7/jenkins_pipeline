pipeline {
    agent {
        docker {
            image "docker.io/aquasec/trivy"
        }
    }

    stages{
        stage('checkout'){
            checkout scm
        }
        stage("Trivey FS Scan"){
            steps{
                sh 'trivy fs --exit-code 1 --severity HIGH,CRITICAL .'
            }
        }
    }
}